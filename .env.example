# ============================================================
# 秋招 OS (fallsurvivor) 环境变量模板
# 复制为 .env 后填写。.env 已被 gitignore，切勿提交。
# 后端启动时对必填项 fail-fast，不提供任何默认凭据。
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=development           # development | production
LOG_LEVEL=info                # debug | info | warn | error
SERVER_PORT=9090

# ---------- 数据库（必填） ----------
DATABASE_URL=postgres://jobos:CHANGE_ME@localhost:5432/jobos?sslmode=disable

# ---------- Redis（必填） ----------
REDIS_URL=redis://localhost:6379/0

# ---------- AI：大模型（可选，留空则降级为纯规则模式） ----------
# 优先使用阿里云百炼-千问（OpenAI 兼容接口）；未配置 QWEN_API_KEY 时回退 DeepSeek。
# 只需把下面 DEEPSEEK_* 改成 QWEN_API_KEY 即可切换供应商，无需改动其他配置。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=glm-5.2
QWEN_TIMEOUT_SECONDS=90

# 回退供应商（当 QWEN_API_KEY 为空时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90

# ---------- Search：Tavily（可选，留空则无法在线获取岗位） ----------
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=30

# ---------- Playwright Worker ----------
# Worker 只监听回环地址，禁止暴露到公网
BROWSER_WORKER_URL=http://127.0.0.1:8390
BROWSER_WORKER_TOKEN=CHANGE_ME_RANDOM_LONG_TOKEN

# ---------- 文件存储（简历上传，必须位于 web root 之外） ----------
STORAGE_DIR=./storage/resumes
MAX_UPLOAD_MB=10

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- 抓取安全（SSRF 防护） ----------
# 允许出网抓取 JD 页面；关闭后仅使用搜索接口返回的 snippet
ALLOW_OUTBOUND_FETCH=true

# ============================================================
# 前端（frontend/.env.local）
# NEXT_PUBLIC_API_BASE_URL=http://localhost:9090/api
# ============================================================
