{
  "name": "jobos-browser-worker",
  "version": "1.0.0",
  "private": true,
  "description": "秋招 OS 的 Playwright 辅助填写 Worker。只做表单读取与非敏感字段填写，绝不点击最终提交。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "playwright": "1.48.2"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
