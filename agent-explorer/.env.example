# Agent Explorer 配置（复制为 .env 后填写）
# 通义千问（生产 Planner/Actor 调用，dashscope OpenAI 兼容接口）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
# 兼容兜底：若不设 QWEN_API_KEY，可复用此变量（本机曾沿用该名存放 dashscope key）
DEEPSEEK_API_KEY=

# 与 Go 后端双向校验的令牌（必须与后端 .env 的 BROWSER_WORKER_TOKEN 一致）
BROWSER_WORKER_TOKEN=

# 是否离线运行：true 时不联网、不调浏览器，只用 backend/testdata/pages 样本做回归
OFFLINE=true

# 探索循环参数
MAX_STEPS=12
CONFIDENCE_THRESHOLD=70

# 服务监听
HOST=0.0.0.0
PORT=8400

# 复用你在 worker-browser 里手动登录过的 Chromium profile（生产 Actor 用）
PROFILE_DIR=../worker-browser/.auth
